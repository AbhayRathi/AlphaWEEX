# WEEX API Configuration (Note: WEEX not yet in CCXT - using Binance as demo fallback)
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_API_PASSWORD=your_api_password_here

# WEEX v2 API Configuration (Competition-Ready Bot)
# Base URL: https://api-contract.weex.com
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSWORD=your_api_password_here

# Cloudflare 521 Hardening Configuration
# Delay between API calls (in seconds) to avoid rate limiting
WEEX_API_DELAY=0.5
# Base backoff time for 521 errors (in seconds)
WEEX_521_BASE_BACKOFF=8
# Maximum backoff time cap for 521 errors (in seconds)
WEEX_521_MAX_BACKOFF=45
# Minimum jitter added to 521 backoff (seconds)
WEEX_521_MIN_JITTER=5
# Maximum jitter added to 521 backoff (seconds)
WEEX_521_MAX_JITTER=25
# Skip leverage initialization to reduce 404 noise
WEEX_DISABLE_LEVERAGE_INIT=true
# TTL (seconds) for pending-orders cache to reduce API calls
WEEX_PENDING_ORDERS_TTL=10
# Emergency kill-switch to bypass liquid capital calculation (default: false)
WEEX_DISABLE_LIQUID_CAPITAL=false
# Multiply fallback "available" by this factor (e.g., 0.98 for extra caution)
# When /getAccounts lacks explicit available field, available is derived from amount/legacy_amount
WEEX_AVAILABLE_FALLBACK_HAIRCUT=1.0

# Volatility Bypass Configuration (for competition window toggles)
# Set to true to completely disable volatility filter and allow trades at any volatility
WEEX_DISABLE_VOLATILITY_BYPASS=false
# Threshold in % for 5-min price change to trigger bypass (default: 0.33)
# Set to 1.0 (or higher) to effectively always bypass the volatility filter
VOLATILITY_BYPASS_PCT=0.33

# Contract Symbol Resolution Override (for CI/testing)
# Set to JSON string to override contract discovery
# Example: WEEX_CONTRACT_MAP_OVERRIDE='{"BTCUSDT":"BTCUSDT_UMCBL","ETHUSDT":"ETHUSDT_UMCBL"}'
# Leave empty for production (uses live API discovery)
WEEX_CONTRACT_MAP_OVERRIDE=

# Symbol Format Hint (for CI/testing)
# Pre-seed the per-endpoint symbol format cache to avoid runtime auto-detection
# Format: JSON object or array of objects with path, symbol, and format keys
# Example single: WEEX_SYMBOL_FORMAT_HINT='{"path":"/capi/v2/order/placeOrder","symbol":"BTCUSDT","format":"cmt"}'
# Example array: WEEX_SYMBOL_FORMAT_HINT='[{"path":"/capi/v2/order/placeOrder","symbol":"BTCUSDT","format":"cmt"}]'
# Valid formats: "contract" (BTCUSDT_UMCBL), "cmt" (cmt_btcusdt), "plain" (BTCUSDT)
# Leave empty for production (auto-detects and caches on first 40020 fallback)
WEEX_SYMBOL_FORMAT_HINT=

# Advanced/Future Features (Optional - Not Yet Implemented)
# USE_CURL_CFFI=false  # Reserved for future TLS impersonation (requires curl_cffi package)


# LLM Configuration for Autonomous Trading Strategy
# Provider auto-detection priority: DeepSeek > OpenAI > Anthropic
# Optional: Set LLM_PROVIDER to force a specific provider ('deepseek', 'openai', or 'anthropic')
LLM_PROVIDER=
# DeepSeek API Key (recommended - most cost-effective)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Override default model (e.g., deepseek-reasoner, gpt-4o-mini, claude-3-5-sonnet-20241022)
LLM_MODEL=
# Optional: Override base URL for DeepSeek
LLM_BASE_URL=

# Exchange to use (default: binance for demo)
EXCHANGE_ID=binance

# DeepSeek Configuration (if using API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-r1

# Alpaca Market Data API (Phase 4 - TradFi Oracle)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Trading Configuration
TRADING_SYMBOL=BTC/USDT
INITIAL_EQUITY=1000.0
KILL_SWITCH_THRESHOLD=0.03
STABILITY_LOCK_HOURS=12
REASONING_INTERVAL_MINUTES=15
