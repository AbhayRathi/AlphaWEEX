# WEEX API Configuration (Note: WEEX not yet in CCXT - using Binance as demo fallback)
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_API_PASSWORD=your_api_password_here

# WEEX v2 API Configuration (Competition-Ready Bot)
# Base URL: https://api-contract.weex.com
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSWORD=your_api_password_here

# Cloudflare 521 Hardening Configuration
# Delay between API calls (in seconds) to avoid rate limiting
WEEX_API_DELAY=0.5
# Base backoff time for 521 errors (in seconds)
WEEX_521_BASE_BACKOFF=8
# Maximum backoff time cap for 521 errors (in seconds)
WEEX_521_MAX_BACKOFF=45
# Skip leverage initialization to reduce 404 noise
WEEX_DISABLE_LEVERAGE_INIT=true

# Advanced/Future Features (Optional - Not Yet Implemented)
# USE_CURL_CFFI=false  # Reserved for future TLS impersonation (requires curl_cffi package)


# LLM Configuration for Autonomous Trading Strategy
# Provider auto-detection priority: DeepSeek > OpenAI > Anthropic
# Optional: Set LLM_PROVIDER to force a specific provider ('deepseek', 'openai', or 'anthropic')
LLM_PROVIDER=
# DeepSeek API Key (recommended - most cost-effective)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Override default model (e.g., deepseek-reasoner, gpt-4o-mini, claude-3-5-sonnet-20241022)
LLM_MODEL=
# Optional: Override base URL for DeepSeek
LLM_BASE_URL=

# Exchange to use (default: binance for demo)
EXCHANGE_ID=binance

# DeepSeek Configuration (if using API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-r1

# Alpaca Market Data API (Phase 4 - TradFi Oracle)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Trading Configuration
TRADING_SYMBOL=BTC/USDT
INITIAL_EQUITY=1000.0
KILL_SWITCH_THRESHOLD=0.03
STABILITY_LOCK_HOURS=12
REASONING_INTERVAL_MINUTES=15
